{
  "manifest_version": 3,
  "name": "手势视频控制 · Gesture Video Control",
  "version": "1.2.0",
  "description": "用摄像头手势控制网页视频播放：OK 播放/暂停，小拇指调音量，食指切视频或滑动刷短视频，手掌张开切换模式，666 手势可锁定，🤟 刷 B 站更顺手。",
  "minimum_chrome_version": "110",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen",
    "debugger",
    "alarms"
  ],
  "host_permissions": [
    "https://bilibili.com/*",
    "https://*.bilibili.com/*",
    "https://youtube.com/*",
    "https://*.youtube.com/*",
    "https://youtube-nocookie.com/*",
    "https://*.youtube-nocookie.com/*",
    "https://douyin.com/*",
    "https://*.douyin.com/*",
    "https://v.qq.com/*",
    "https://*.v.qq.com/*",
    "https://iqiyi.com/*",
    "https://*.iqiyi.com/*",
    "https://youku.com/*",
    "https://*.youku.com/*",
    "https://ixigua.com/*",
    "https://*.ixigua.com/*",
    "https://mgtv.com/*",
    "https://*.mgtv.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://bilibili.com/*",
        "https://*.bilibili.com/*",
        "https://youtube.com/*",
        "https://*.youtube.com/*",
        "https://youtube-nocookie.com/*",
        "https://*.youtube-nocookie.com/*",
        "https://douyin.com/*",
        "https://*.douyin.com/*",
        "https://v.qq.com/*",
        "https://*.v.qq.com/*",
        "https://iqiyi.com/*",
        "https://*.iqiyi.com/*",
        "https://youku.com/*",
        "https://*.youku.com/*",
        "https://ixigua.com/*",
        "https://*.ixigua.com/*",
        "https://mgtv.com/*",
        "https://*.mgtv.com/*"
      ],
      "js": ["gesture-catalog.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "手势视频控制",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
